#!/usr/bin/env bash
set -euo pipefail

# post-tool-use — Auto-log vault file operations to _changelog.txt.
# Fired by PostToolUse hook via run-hook.cmd.
# Reads stdin JSON, determines if a vault file was written/edited/moved,
# and appends a timestamped entry to _changelog.txt.

# ── Resolve paths ────────────────────────────────────────────────────────────

PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/cortex/plugin-data}"
CONFIG_FILE="$HOME/.claude/cortex/config.json"

# python3 is required to parse the stdin JSON payload. If it's missing, exit
# silently — the plugin still works for non-vault sessions but auto-changelog
# logging and re-embedding are unavailable on this platform.
if ! command -v python3 &>/dev/null; then
    printf '{}\n'
    exit 0
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# ── Step 1: Read stdin JSON ──────────────────────────────────────────────────

INPUT=$(cat)

# ── Session-cache namespace derivation (W3.6) ───────────────────────────────
# KEEP IN SYNC with hooks/session-start and hooks/stop. See session-start for
# the full rationale. Derives a deterministic per-session namespace from the
# stdin session_id (→ $CLAUDE_SESSION_ID → cwd hash → "default").
cortex_session_ns() {
    local raw=""
    raw="$(printf '%s' "${1:-}" | python3 -c "
import json, sys
try:
    print(json.loads(sys.stdin.read()).get('session_id', '') or '', end='')
except Exception:
    pass
" 2>/dev/null || true)"
    if [[ -z "$raw" ]]; then
        raw="${CLAUDE_SESSION_ID:-}"
    fi
    if [[ -z "$raw" ]]; then
        local h=""
        if command -v shasum &>/dev/null; then
            h="$(printf '%s' "${PWD:-/}" | shasum 2>/dev/null | cut -c1-16)"
        elif command -v sha1sum &>/dev/null; then
            h="$(printf '%s' "${PWD:-/}" | sha1sum 2>/dev/null | cut -c1-16)"
        fi
        raw="cwd-${h:-unknown}"
    fi
    raw="$(printf '%s' "$raw" | tr -c 'A-Za-z0-9_-' '_' )"
    raw="${raw:0:64}"
    printf '%s' "${raw:-default}"
}

SESSION_NS="$(cortex_session_ns "$INPUT")"
NS_DIR="$PLUGIN_DATA/session-cache/ns/$SESSION_NS"

# ── write_mode (W3.2 / T18) ─────────────────────────────────────────────────
# Capture write posture, read from config.json `write_mode`:
#   silent        — auto-log captures with no friction (default; the original
#                   value prop devs liked).
#   confirm       — auto-log, but the end-of-turn summary asks the user to
#                   confirm the batched captures landed where intended.
#   explicit-only — only surface captures triggered by an explicit phrase; the
#                   batched summary is advisory and reminds the user that
#                   silent auto-capture is off.
# The auto-changelog itself is always written (it is an audit record); the mode
# only shapes the surfaced hints, never data integrity.
WRITE_MODE="silent"
if [[ -f "$CONFIG_FILE" ]]; then
    WRITE_MODE="$(python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        m = json.load(f).get('write_mode', 'silent')
    print(m if m in ('silent','confirm','explicit-only') else 'silent', end='')
except Exception:
    print('silent', end='')
" 2>/dev/null || printf 'silent')"
fi
[[ -z "$WRITE_MODE" ]] && WRITE_MODE="silent"

# ── Step 2: Extract tool_name and file path ──────────────────────────────────

PARSED="$(python3 -c "
import json, sys

data = json.loads(sys.argv[1])
tool_name = data.get('tool_name', '')

tool_input = data.get('tool_input', {})

# Determine which field holds the file path
if tool_name in ('Write', 'Edit'):
    file_path = tool_input.get('file_path', '')
elif tool_name == 'mcp__obsidian__move_note':
    file_path = tool_input.get('newPath', '')
else:
    file_path = tool_input.get('path', '')

print(tool_name)
print(file_path)
" "$INPUT" 2>/dev/null)" || exit 0

TOOL_NAME="$(echo "$PARSED" | sed -n '1p')"
FILE_PATH="$(echo "$PARSED" | sed -n '2p')"

if [[ -z "$TOOL_NAME" || -z "$FILE_PATH" ]]; then
    exit 0
fi

# ── Step 3: Resolve vault path ───────────────────────────────────────────────

# W3.6: prefer this session's namespaced cache; fall back to the legacy
# top-level mirror so a session whose session-start predates namespacing (or a
# platform that doesn't pass session_id) still resolves the vault.
CACHE_FILE="$NS_DIR/vault-path.txt"
LEGACY_CACHE_FILE="$PLUGIN_DATA/session-cache/vault-path.txt"
VAULT_PATH=""

if [[ -f "$CACHE_FILE" && -s "$CACHE_FILE" ]]; then
    VAULT_PATH="$(cat "$CACHE_FILE")"
elif [[ -f "$LEGACY_CACHE_FILE" && -s "$LEGACY_CACHE_FILE" ]]; then
    VAULT_PATH="$(cat "$LEGACY_CACHE_FILE")"
fi

if [[ -z "$VAULT_PATH" && -f "$CONFIG_FILE" ]]; then
    VAULT_PATH="$(python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        print(json.load(f).get('vault_path', ''))
except Exception:
    pass
" 2>/dev/null)" || true
fi

if [[ -z "$VAULT_PATH" || ! -d "$VAULT_PATH" ]]; then
    exit 0
fi

# ── Step 4: Determine absolute path and check if inside vault ────────────────

ABS_PATH=""

case "$TOOL_NAME" in
    Write|Edit)
        # Write/Edit use absolute paths — compare directly
        ABS_PATH="$FILE_PATH"
        ;;
    mcp__obsidian__*)
        # Obsidian MCP tools use paths relative to vault root
        ABS_PATH="$VAULT_PATH/$FILE_PATH"
        ;;
    *)
        exit 0
        ;;
esac

# Check if inside vault (ABS_PATH must start with VAULT_PATH)
case "$ABS_PATH" in
    "$VAULT_PATH"/*)
        ;; # good — inside vault
    *)
        exit 0
        ;;
esac

# ── Step 5: Skip operational files ───────────────────────────────────────────

FILENAME="$(basename "$ABS_PATH")"

case "$FILENAME" in
    _changelog.txt|_pipeline_state.json|_session_manifest.md)
        exit 0
        ;;
esac

# ── Step 6: Infer action type ───────────────────────────────────────────────

ACTION=""
case "$TOOL_NAME" in
    Write|mcp__obsidian__write_note)
        ACTION="CREATED"
        ;;
    Edit|mcp__obsidian__patch_note|mcp__obsidian__update_frontmatter)
        ACTION="UPDATED"
        ;;
    mcp__obsidian__move_note)
        ACTION="MOVED"
        ;;
    mcp__obsidian__manage_tags)
        ACTION="TAGGED"
        ;;
    *)
        exit 0
        ;;
esac

# ── Step 7: Compute relative path ───────────────────────────────────────────

# Strip vault prefix + leading slash to get vault-relative path
REL_PATH="${ABS_PATH#"$VAULT_PATH"/}"
REL_DIR="$(dirname "$REL_PATH")"
if [[ "$REL_DIR" == "." ]]; then
    REL_DIR=""
else
    REL_DIR="$REL_DIR/"
fi

# ── Step 6b: Detect Knowledge Base writes for learning intake tagging ────────

KB_SOURCE=""
case "$REL_PATH" in
    "Knowledge Base/"*)
        # Check if this write was initiated by cortex-coach (namespaced, with
        # legacy fallback per W3.6).
        COACH_FLAG="$NS_DIR/coach-active.flag"
        LEGACY_COACH_FLAG="$PLUGIN_DATA/session-cache/coach-active.flag"
        if [[ -f "$COACH_FLAG" || -f "$LEGACY_COACH_FLAG" ]]; then
            KB_SOURCE=" [source:coaching]"
        else
            KB_SOURCE=" [source:capture]"
        fi
        ;;
esac

# ── Step 8: Append to _changelog.txt via shared Node helper ─────────────────
# All changelog writers (MCP tools, this hook, reindex-one) go through
# lib/changelog-format.js so the line shape stays in lockstep. If `node` is
# missing, fall back to the inline format — slightly drift-prone but keeps
# the hook from going dark on systems without Node on PATH.

PLUGIN_ROOT_FOR_CLI="${CLAUDE_PLUGIN_ROOT:-${CURSOR_PLUGIN_ROOT:-}}"
APPEND_CLI="$PLUGIN_ROOT_FOR_CLI/mcp-servers/cortex-vault/bin/append-changelog-cli.js"
NOTE_TEXT="Auto-logged by hook${KB_SOURCE}"

if [[ -n "$PLUGIN_ROOT_FOR_CLI" && -f "$APPEND_CLI" ]] && command -v node &>/dev/null; then
    node "$APPEND_CLI" "$VAULT_PATH" "$ACTION" "$FILENAME" "$REL_DIR" "$NOTE_TEXT" --automated >/dev/null 2>&1 || true
else
    CHANGELOG="$VAULT_PATH/_changelog.txt"
    TIMESTAMP="$(date '+%Y-%m-%d %H:%M')"
    ENTRY="[$TIMESTAMP] $ACTION [auto] | FILE: $FILENAME | DEST: $REL_DIR | NOTE: $NOTE_TEXT"
    echo "$ENTRY" >> "$CHANGELOG"
fi

# ── Step 8b: Re-index .md file into semantic search (debounced serial queue) ─
#
# W2.2 — Replace the old fire-and-forget per-write spawn (which launched an
# unbounded number of detached `reindex-one` processes — one per save, racing
# each other on the same SQLite DB) with a debounced, serialized queue:
#
#   1. Append the changed path to a per-session queue file.
#   2. Start ONE background drainer, guarded by an atomic mkdir lock. If a
#      drainer is already running it simply exits — the running drainer will
#      pick up paths appended after it started, so nothing is lost.
#   3. The drainer debounces briefly (coalescing rapid bursts), then drains the
#      queue serially (one reindex at a time), logging failures to stderr
#      instead of swallowing them.
#
# This caps reindex concurrency at one worker and removes the per-write race,
# without depending on the stop hook to drain (stop-hook draining is a separate
# follow-up owned elsewhere). Each save still gets reindexed within the session.

if [[ "$FILENAME" == *.md ]]; then
    SKIP_REINDEX=0
    case "$REL_PATH" in
        .cortex/*|_Templates/*|Archives/*|.*)
            SKIP_REINDEX=1
            ;;
    esac
    if [[ "$SKIP_REINDEX" == "0" ]]; then
        PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-${CURSOR_PLUGIN_ROOT:-}}"
        REINDEX_BIN="$PLUGIN_ROOT/mcp-servers/cortex-vault/bin/reindex-one.js"
        if [[ -n "$PLUGIN_ROOT" && -f "$REINDEX_BIN" ]] && command -v node &>/dev/null; then
            # W3.6: per-session reindex queue/lock so concurrent sessions
            # don't share one drain.lock (which would starve all but one).
            REINDEX_DIR="$NS_DIR/reindex"
            mkdir -p "$REINDEX_DIR" 2>/dev/null || true
            QUEUE_FILE="$REINDEX_DIR/queue.txt"
            LOCK_DIR="$REINDEX_DIR/drain.lock"

            # Enqueue: one tab-separated "vault<TAB>relpath" line per change.
            printf '%s\t%s\n' "$VAULT_PATH" "$REL_PATH" >> "$QUEUE_FILE" 2>/dev/null || true

            # Try to become the single drainer (atomic mkdir is the lock).
            if mkdir "$LOCK_DIR" 2>/dev/null; then
                (
                    # Release the lock no matter how we exit.
                    trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
                    # Debounce: let a burst of rapid saves accumulate first.
                    sleep 1
                    # Drain serially until the queue is empty.
                    while [[ -s "$QUEUE_FILE" ]]; do
                        # Atomically claim the current batch.
                        BATCH="$QUEUE_FILE.draining"
                        mv "$QUEUE_FILE" "$BATCH" 2>/dev/null || break
                        # De-dupe so repeated saves of one file embed once.
                        awk '!seen[$0]++' "$BATCH" 2>/dev/null | while IFS=$'\t' read -r Q_VAULT Q_REL; do
                            [[ -z "$Q_VAULT" || -z "$Q_REL" ]] && continue
                            node "$REINDEX_BIN" "$Q_VAULT" "$Q_REL" >/dev/null 2>>"$REINDEX_DIR/drain.log" || \
                                printf '[cortex-vault] reindex failed: %s\n' "$Q_REL" >> "$REINDEX_DIR/drain.log"
                        done
                        rm -f "$BATCH" 2>/dev/null || true
                    done
                ) >/dev/null 2>&1 &
                disown 2>/dev/null || true
            fi
        fi
    fi
fi

# ── Step 9: Record write into the per-turn batch + emit ONE batched hint ─────
# W3.2 (T18): the old behavior emitted a verbose per-write hint on EVERY vault
# write, which defeats the documented "one batched confirmation per turn" rule.
# Instead we append each write to a per-session capture log and emit a single,
# compact running summary. The stop hook reads this log to produce the final
# end-of-turn batched summary (with flushed memory content) and clears it.

CAPTURE_LOG="$NS_DIR/turn-captures.log"
mkdir -p "$NS_DIR" 2>/dev/null || true
# One tab-separated "ACTION<TAB>FILENAME<TAB>REL_DIR" line per write.
printf '%s\t%s\t%s\n' "$ACTION" "$FILENAME" "$REL_DIR" >> "$CAPTURE_LOG" 2>/dev/null || true

# Count writes accumulated this turn (best-effort).
WRITE_COUNT="$(grep -c '' "$CAPTURE_LOG" 2>/dev/null | tr -dc '0-9' || true)"
WRITE_COUNT="${WRITE_COUNT:-1}"

# Compact, non-spammy hint. The MOC nag is only worth surfacing once, on the
# first CREATE of the turn — repeating it per file is the noise the audit flagged.
MODE_NOTE=""
case "$WRITE_MODE" in
    confirm)       MODE_NOTE=" [write_mode:confirm — confirm these captures at end of turn]" ;;
    explicit-only) MODE_NOTE=" [write_mode:explicit-only — auto-capture advisory]" ;;
esac

if [[ "$WRITE_COUNT" -le 1 ]]; then
    if [[ "$ACTION" == "CREATED" ]]; then
        HINT="Captured: $ACTION $FILENAME ($REL_DIR). New file — consider updating the folder's _MOC.md. (1 vault write this turn)$MODE_NOTE"
    else
        HINT="Captured: $ACTION $FILENAME ($REL_DIR). (1 vault write this turn)$MODE_NOTE"
    fi
else
    HINT="Captured: $ACTION $FILENAME ($REL_DIR). ($WRITE_COUNT vault writes this turn — a batched summary will follow at end of turn.)$MODE_NOTE"
fi

CONTEXT="<cortex-changelog>$HINT</cortex-changelog>"
ESCAPED="$(escape_for_json "$CONTEXT")"

# ── Step 10: Output platform-appropriate JSON ───────────────────────────────

if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
    # Cursor
    printf '{"additional_context":"%s"}\n' "$ESCAPED"
elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" && -z "${COPILOT_CLI:-}" ]]; then
    # Claude Code
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' "$ESCAPED"
else
    # Copilot CLI / default
    printf '{"additionalContext":"%s"}\n' "$ESCAPED"
fi
