#!/usr/bin/env bash
set -euo pipefail

# session-start — Load vault context before the model's first turn.
# Calls hooks/lib/boot-context.py for all vault reading and cwd resolution.
# If config is missing or vault doesn't exist, exits silently (onboarding mode).

# ── Resolve paths ────────────────────────────────────────────────────────────

PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/cortex/plugin-data}"
if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    PLUGIN_ROOT="$CLAUDE_PLUGIN_ROOT"
else
    PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi

# Allow test override, otherwise default
CONFIG_FILE="${CORTEX_BOOT_CONFIG:-$HOME/.claude/cortex/config.json}"

# ── Read stdin (carries session_id) ─────────────────────────────────────────
# All three lifecycle hooks (session-start, post-tool-use, stop) receive the
# SAME session_id in their stdin payload within one Claude session, so deriving
# the cache namespace from it keeps concurrent sessions from clobbering each
# other's singleton files. SessionStart input may be empty on some platforms;
# guard the read so `set -e` never trips on a closed stdin.
INPUT=""
if [[ ! -t 0 ]]; then
    INPUT="$(cat 2>/dev/null || true)"
fi

# ── Check python3 ───────────────────────────────────────────────────────────

if ! command -v python3 &>/dev/null; then
    exit 0
fi

# ── Session-cache namespace derivation (W3.6) ───────────────────────────────
# KEEP IN SYNC with hooks/post-tool-use and hooks/stop.
# Deterministic per-session namespace so concurrent sessions don't share the
# session-cache singletons (vault-path.txt, pending-*.json, reindex queue).
# Priority: session_id from the stdin payload → $CLAUDE_SESSION_ID env →
# a stable hash of the cwd → the literal "default". The result is sanitized to
# [A-Za-z0-9_-] and length-capped so it is always a safe directory name.
cortex_session_ns() {
    local raw=""
    raw="$(printf '%s' "${1:-}" | python3 -c "
import json, sys
try:
    print(json.loads(sys.stdin.read()).get('session_id', '') or '', end='')
except Exception:
    pass
" 2>/dev/null || true)"
    if [[ -z "$raw" ]]; then
        raw="${CLAUDE_SESSION_ID:-}"
    fi
    if [[ -z "$raw" ]]; then
        # Stable hash of cwd. shasum is on macOS; sha1sum on Linux.
        local h=""
        if command -v shasum &>/dev/null; then
            h="$(printf '%s' "${PWD:-/}" | shasum 2>/dev/null | cut -c1-16)"
        elif command -v sha1sum &>/dev/null; then
            h="$(printf '%s' "${PWD:-/}" | sha1sum 2>/dev/null | cut -c1-16)"
        fi
        raw="cwd-${h:-unknown}"
    fi
    # Sanitize to a safe directory token.
    raw="$(printf '%s' "$raw" | tr -c 'A-Za-z0-9_-' '_' )"
    raw="${raw:0:64}"
    printf '%s' "${raw:-default}"
}

SESSION_NS="$(cortex_session_ns "$INPUT")"

# ── Sweep stale namespaces (>24h) ───────────────────────────────────────────
# Old per-session cache dirs accumulate one-per-session forever otherwise.
# Best-effort: never fails the hook.
NS_ROOT="$PLUGIN_DATA/session-cache/ns"
if [[ -d "$NS_ROOT" ]]; then
    find "$NS_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null || true
fi

# ── Call Python module ──────────────────────────────────────────────────────

BOOT_JSON="$(python3 "$PLUGIN_ROOT/hooks/lib/boot-context.py" \
    --config "$CONFIG_FILE" \
    --cwd "${PWD:-/}" 2>/dev/null)" || exit 0

if [[ -z "$BOOT_JSON" ]]; then
    exit 0
fi

# ── Cache vault path for other hooks ────────────────────────────────────────
# (Reference files in references/*.md are read directly by skills; user-prompt-submit
# uses hardcoded patterns. No reason to mirror them into plugin-data.)
#
# W3.6: cache files live under a per-session namespace dir so two concurrent
# sessions never clobber each other's singletons. We also mirror vault-path.txt
# to the legacy top-level location for backward compatibility with any reader
# that hasn't been namespaced yet — but the namespaced copy is authoritative.

CACHE_DIR="$PLUGIN_DATA/session-cache"
NS_DIR="$CACHE_DIR/ns/$SESSION_NS"
mkdir -p "$NS_DIR"

# Truncate the legacy top-level vault-path.txt at the top of session-start so a
# stale path from a previous session can never leak into this one before we
# rewrite it below.
: > "$CACHE_DIR/vault-path.txt" 2>/dev/null || true

# Cache vault path for other hooks (namespaced + legacy mirror).
VAULT_PATH_VALUE="$(python3 -c "import json,sys; print(json.loads(sys.stdin.read())['vault_path'], end='')" <<< "$BOOT_JSON")"
printf '%s' "$VAULT_PATH_VALUE" > "$NS_DIR/vault-path.txt"
printf '%s' "$VAULT_PATH_VALUE" > "$CACHE_DIR/vault-path.txt"

# ── Build session block ─────────────────────────────────────────────────────

SESSION_BLOCK="$(python3 -c "
import json, sys

data = json.loads(sys.stdin.read())
lines = []
lines.append('<cortex-boot-required>')
lines.append('EXTREMELY IMPORTANT: A <cortex-session> block is loaded below. Before responding to the FIRST user message of this session, and before invoking any other skill, you MUST invoke the cortex-boot skill (via the Skill tool) to interpret it.')
lines.append('')
lines.append('This is not negotiable. Skipping cortex-boot causes wrong-project answers, broken status checks, and missed activation-level behavior.')
lines.append('')
lines.append('After cortex-boot has run once in this session, do NOT re-invoke it on subsequent turns — the activation-level contract it applied stays in effect for the whole session.')
lines.append('</cortex-boot-required>')
lines.append('')
lines.append('<cortex-session>')
lines.append(f\"Vault: {data['vault_path']}\")

level = data['activation_level']
level_names = {1: 'L1 — Passive', 2: 'L2 — Vault-Aware', 3: 'L3 — Full Project'}
lines.append(f\"Level: {level_names.get(level, 'L1 — Passive')}\")

p = data.get('project')
if level == 3 and p:
    lines.append(f\"Project: {p.get('name', p['id'])}\")
    if p.get('stage'):
        lines.append(f\"Stage: {p['stage']}\")
    if p.get('blockers'):
        lines.append(f\"Blockers: {'; '.join(p['blockers'])}\")
    if p.get('open_questions'):
        lines.append(f\"Open questions: {len(p['open_questions'])}\")
    if p.get('recent_decisions'):
        lines.append(f\"Recent decisions: {'; '.join(p['recent_decisions'][-3:])}\")
elif data.get('active_projects'):
    lines.append(f\"Active projects: {data['active_projects']}\")

lines.append('')
lines.append('<cortex-personality>')
lines.append((data.get('personality') or '').rstrip())
lines.append('</cortex-personality>')

lines.append('')
lines.append('<cortex-memory>')
lines.append((data.get('memory') or '').rstrip())
lines.append('</cortex-memory>')

lp = data.get('learner_profile') or ''
if lp.strip():
    lines.append('')
    lines.append('<cortex-learner-profile>')
    lines.append(lp.rstrip())
    lines.append('</cortex-learner-profile>')

if data.get('recent_activity'):
    lines.append('')
    lines.append('Recent activity:')
    lines.append(data['recent_activity'])

lines.append(f\"Inbox: {data.get('inbox_count', 0)} unsorted item(s)\")

if data.get('feature_suggestion'):
    lines.append(f\"Feature suggestion: {data['feature_suggestion']}\")

b = data.get('_budget')
if b and b.get('truncated'):
    lines.append(f\"Context budget: {len(b['truncated'])} field(s) trimmed ({', '.join(b['truncated'])}) — ask 'read hub' or 'search vault' for full detail.\")

lines.append('</cortex-session>')
print('\n'.join(lines))
" <<< "$BOOT_JSON")"

# ── Escape and output ───────────────────────────────────────────────────────

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

ESCAPED="$(escape_for_json "$SESSION_BLOCK")"

if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
    printf '{"additional_context":"%s"}\n' "$ESCAPED"
elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" && -z "${COPILOT_CLI:-}" ]]; then
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$ESCAPED"
else
    printf '{"additionalContext":"%s"}\n' "$ESCAPED"
fi
